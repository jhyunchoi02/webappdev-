GDP_INDICATOR = "NY.GDP.PCAP.CD"      # 1인당 GDP, current US$
LIFE_INDICATOR = "SP.DYN.LE00.IN"     # 기대수명, years
START_YEAR = 2000
CURRENT_YEAR = datetime.date.today().year


@st.cache_data(ttl=60 * 60 * 24)
def load_country_metadata():
    """
    World Bank에서 국가 메타데이터를 가져와 실제 국가만 남깁니다.

    World Bank API에는 World, High income, OECD members 같은
    집계 데이터도 포함되어 있으므로, 이 함수에서 실제 국가만 걸러냅니다.
    """
    url = "https://api.worldbank.org/v2/country"
    params = {
        "format": "json",
        "per_page": 400
    }

    response = requests.get(url, params=params, timeout=20)
    response.raise_for_status()
    raw = response.json()

    if len(raw) < 2 or raw[1] is None:
        raise ValueError("국가 메타데이터를 불러오지 못했습니다.")

    rows = []

    for item in raw[1]:
        region = item.get("region", {}) or {}
        income = item.get("incomeLevel", {}) or {}

        rows.append({
            "country_code": item.get("id"),
            "country_name_meta": item.get("name"),
            "region": region.get("value"),
            "income_level": income.get("value"),
        })

    meta = pd.DataFrame(rows)

    # World, High income, OECD members 등 집계 자료는 region 값이 Aggregates입니다.
    meta = meta[meta["region"].notna()]
    meta = meta[meta["region"] != "Aggregates"].copy()

    return meta


@st.cache_data(ttl=60 * 60 * 24)
def load_indicator(indicator_code, start_year=START_YEAR, end_year=CURRENT_YEAR):
    """
    World Bank API에서 특정 지표를 연도 범위로 가져옵니다.

    indicator_code 예:
    - NY.GDP.PCAP.CD: 1인당 GDP
    - SP.DYN.LE00.IN: 기대수명
    """
    url = f"https://api.worldbank.org/v2/country/all/indicator/{indicator_code}"

    params = {
        "format": "json",
        "per_page": 20000,
        "date": f"{start_year}:{end_year}",
    }

    response = requests.get(url, params=params, timeout=30)
    response.raise_for_status()
    raw = response.json()

    if len(raw) < 2 or raw[1] is None:
        raise ValueError(f"{indicator_code} 데이터를 불러오지 못했습니다.")

    rows = []

    for item in raw[1]:
        rows.append({
            "country_name": item.get("country", {}).get("value"),
            "country_code": item.get("countryiso3code"),
            "year": int(item.get("date")),
            "value": item.get("value"),
        })

    return pd.DataFrame(rows)


@st.cache_data(ttl=60 * 60 * 24)
def make_merged_dataset():
    """
    1인당 GDP와 기대수명 데이터를 병합하여 분석용 데이터프레임을 만듭니다.
    """
    meta = load_country_metadata()

    # 1인당 GDP 데이터 불러오기
    gdp = load_indicator(GDP_INDICATOR).rename(
        columns={"value": "gdp_per_capita"}
    )

    # 기대수명 데이터 불러오기
    life = load_indicator(LIFE_INDICATOR).rename(
        columns={"value": "life_expectancy"}
    )

    # 국가 코드와 연도를 기준으로 두 지표를 병합합니다.
    df = pd.merge(
        gdp[["country_name", "country_code", "year", "gdp_per_capita"]],
        life[["country_code", "year", "life_expectancy"]],
        on=["country_code", "year"],
        how="inner"
    )

    # 실제 국가 목록과 병합하여 집계 데이터 제거 + 지역 정보 추가
    df = pd.merge(
        df,
        meta,
        on="country_code",
        how="inner"
    )

    # 숫자형 변환
    df["gdp_per_capita"] = pd.to_numeric(
        df["gdp_per_capita"],
        errors="coerce"
    )

    df["life_expectancy"] = pd.to_numeric(
        df["life_expectancy"],
        errors="coerce"
    )

    # 결측값 제거
    df = df.dropna(
        subset=["gdp_per_capita", "life_expectancy"]
    )

    # 로그 스케일을 위해 GDP가 0 이하인 자료는 제외합니다.
    df = df[df["gdp_per_capita"] > 0].copy()

    return df


def interpret_correlation(r):
    """
    상관계수 r을 학생 눈높이 문장으로 해석합니다.
    """
    if pd.isna(r):
        return "데이터가 부족하여 상관계수를 해석하기 어렵습니다."

    if r >= 0.7:
        return "강한 양의 상관관계가 있습니다. 1인당 GDP가 높을수록 기대수명도 높은 경향이 뚜렷합니다."

    if r >= 0.3:
        return "어느 정도 양의 상관관계가 있습니다. 1인당 GDP가 높을수록 기대수명이 높아지는 경향이 보입니다."

    if r > -0.3:
        return "뚜렷한 직선 관계는 약합니다. 두 변수 사이의 관계가 강하다고 보기 어렵습니다."

    if r > -0.7:
        return "어느 정도 음의 상관관계가 있습니다. 한 변수가 커질 때 다른 변수가 작아지는 경향이 보입니다."

    return "강한 음의 상관관계가 있습니다. 한 변수가 커질수록 다른 변수가 작아지는 경향이 뚜렷합니다."


def add_regression_line(fig, df, use_log_scale):
    """
    산점도 위에 간단한 1차 추세선을 추가합니다.

    로그 스케일일 때는 x값에 log10을 적용해 회귀선을 계산합니다.
    """
    if len(df) < 2:
        return fig

    x = df["gdp_per_capita"].to_numpy(dtype=float)
    y = df["life_expectancy"].to_numpy(dtype=float)

    if use_log_scale:
        x_for_fit = np.log10(x)
        x_line = np.linspace(x.min(), x.max(), 200)
        x_line_for_fit = np.log10(x_line)
    else:
        x_for_fit = x
        x_line = np.linspace(x.min(), x.max(), 200)
        x_line_for_fit = x_line

    # 1차 회귀식 y = ax + b 계산
    slope, intercept = np.polyfit(x_for_fit, y, 1)
    y_line = slope * x_line_for_fit + intercept

    fig.add_trace(
        go.Scatter(
            x=x_line,
            y=y_line,
            mode="lines",
            name="추세선",
            line=dict(color="red", width=3),
            hoverinfo="skip"
        )
    )

    return fig


